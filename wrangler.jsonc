{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "workflows-starter-template",
    "main": "worker/index.ts",
    "compatibility_date": "2025-06-01",
    "observability": {
        "enabled": true
    },
    "workflows": [
        {
            "name": "my-workflow",
            "binding": "MY_WORKFLOW",
            "class_name": "MyWorkflow"
        }
    ],
    "upload_source_maps": true
}